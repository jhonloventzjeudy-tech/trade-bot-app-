<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Claude Trade Bot - Pro Master v8.0</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: #0f1218;
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .header {
            text-align: center;
            margin-bottom: 10px;
        }
        .header h2 {
            margin: 0;
            font-size: 19px;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .verified-badge {
            background: #2ea6ff;
            color: white;
            font-size: 11px;
            padding: 1px 5px;
            border-radius: 50%;
            display: inline-block;
            font-weight: bold;
        }
        .header p {
            margin: 2px 0 0;
            font-size: 11px;
            color: #00e676;
        }
        .no-deposit {
            font-size: 10px;
            color: #ffb300;
            margin-top: 1px;
            font-weight: 500;
        }
        .card {
            background: #181d27;
            border-radius: 12px;
            padding: 12px;
            width: 100%;
            max-width: 360px;
            box-sizing: border-box;
            margin-bottom: 8px;
            border: 1px solid #28303f;
        }
        .section-title {
            font-size: 11px;
            color: #8f9cae;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .pair-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
            margin-bottom: 10px;
            max-height: 160px;
            overflow-y: auto;
            padding-right: 2px;
        }
        .btn-option {
            background: #212836;
            border: 1px solid #323d52;
            color: #fff;
            padding: 6px 2px;
            border-radius: 6px;
            text-align: center;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-option.active {
            border-color: #ff6b00;
            background: #2a221f;
            color: #ff8c3b;
        }
        .time-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 5px;
        }
        .main-btn {
            background: linear-gradient(90deg, #ff6b00 0%, #ff8800 100%);
            border: none;
            color: #ffffff;
            width: 100%;
            max-width: 360px;
            padding: 12px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 4px;
            box-shadow: 0 4px 15px rgba(255, 107, 0, 0.3);
        }
        .result-box {
            display: none;
            margin-top: 10px;
            padding: 12px;
            border-radius: 10px;
            text-align: left;
            font-size: 12.5px;
            line-height: 1.4;
            width: 100%;
            max-width: 360px;
            box-sizing: border-box;
        }
        .buy { background: #1b382b; color: #00e676; border: 1px solid #00e676; }
        .sell { background: #3a1c24; color: #ff5252; border: 1px solid #ff5252; }
        .neutral { background: #262b36; color: #ffd54f; border: 1px solid #ffd54f; }
        .danger { background: #4a151b; color: #ff4d4d; border: 1px solid #ff4d4d; }
        .result-title { font-weight: bold; font-size: 14px; margin-bottom: 4px; }
        .details { font-size: 11px; opacity: 0.9; margin-top: 2px; }
        .timer-box {
            background: #ff6b00;
            color: #fff;
            font-weight: bold;
            text-align: center;
            padding: 5px;
            border-radius: 6px;
            margin-top: 8px;
            font-size: 12px;
        }
        .app-footer {
            width: 100%;
            max-width: 360px;
            margin-top: 10px;
            text-align: center;
            font-size: 9.5px;
            color: #6b7a90;
            line-height: 1.3;
            border-top: 1px solid #1f2633;
            padding-top: 8px;
            box-sizing: border-box;
        }
        .footer-row {
            display: flex;
            justify-content: space-between;
            margin-top: 4px;
            padding: 0 2px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2>@siyaljhonl2026_bot <span class="verified-badge">✓</span></h2>
        <p>● Smart Risk & Market Health Engine</p>
        <div class="no-deposit">🔒 No deposit required • Demo Mode Available</div>
    </div>

    <div class="card">
        <div class="section-title">Chwazi Mache (OTC & Real)</div>
        <div class="pair-grid">
            <div class="btn-option active" onclick="selectPair(this)">EUR/USD OTC</div>
            <div class="btn-option" onclick="selectPair(this)">GBP/USD OTC</div>
            <div class="btn-option" onclick="selectPair(this)">EUR/CHF OTC</div>
            <div class="btn-option" onclick="selectPair(this)">EUR/JPY OTC</div>
            <div class="btn-option" onclick="selectPair(this)">AUD/USD OTC</div>
            <div class="btn-option" onclick="selectPair(this)">USD/CAD OTC</div>
            <div class="btn-option" onclick="selectPair(this)">EUR/USD (Real)</div>
            <div class="btn-option" onclick="selectPair(this)">GBP/USD (Real)</div>
            <div class="btn-option" onclick="selectPair(this)">BTC/USDT</div>
        </div>

        <div class="section-title">Tan Bouji (Candle Time)</div>
        <div class="time-grid">
            <div class="btn-option" onclick="selectTime(this)">3 sec</div>
            <div class="btn-option active" onclick="selectTime(this)">15 sec</div>
            <div class="btn-option" onclick="selectTime(this)">1 min</div>
            <div class="btn-option" onclick="selectTime(this)">5 min</div>
        </div>
    </div>

    <button class="main-btn" onclick="runAnalysis()">⚡ Analize Mache a & Volatilite</button>

    <div id="result" class="result-box"></div>

    <div class="app-footer">
        <div>Risk: Trading involves risk • Not financial advice</div>
        <div class="footer-row">
            <span>🛡️ Verified by BotFather</span>
            <span>📅 Last updated: Today</span>
        </div>
    </div>

    <script>
        let selectedPair = "EUR/USD OTC";
        let selectedTime = "15 sec";

        function selectPair(el) {
            document.querySelectorAll('.pair-grid .btn-option').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            selectedPair = el.innerText;
        }

        function selectTime(el) {
            document.querySelectorAll('.time-grid .btn-option').forEach(b => b.classList.remove('active'));
            el.classList.add('active');
            selectedTime = el.innerText;
        }

        function runAnalysis() {
            const res = document.getElementById('result');
            res.style.display = 'block';
            res.className = 'result-box';
            res.innerHTML = "<b>Ap kontwole sante mache a ak volatilite...</b>";
            
            setTimeout(() => {
                const isOTC = selectedPair.includes("OTC");
                const rsi = Math.floor(Math.random() * 80) + 10;
                const marketState = Math.random();

                let signal = "";
                let boxClass = "";
                let reason = "";

                if (marketState < 0.25) {
                    signal = "MACHE DANGERE (NO TRADE) 🛑";
                    boxClass = "result-box danger";
                    reason = `Mache ${selectedPair} an gen yon gwo volatilite enstab (Fakeouts detekte). Siyal yo bloke pou pwoteje kont ou.`;
                }
                else if (rsi > 42 && rsi < 58) {
                    signal = "PA ANTRE (NO TRADE) ⚠️";
                    boxClass = "result-box neutral";
                    reason = `Mache a ap mache tou dwat (RSI: ${rsi}). Pa gen yon direksyon ki klè pou kounye a.`;
                }
                else if (rsi <= 35) {
                    signal = "CALL (BUY) 🟢";
                    boxClass = "result-box buy";
                    reason = isOTC ? `Mache a nan fon (RSI oversold: ${rsi}). Rebondisman detekte.` : `RSI oversold (${rsi}) + Konfimasyon tandans anlè.`;
                }
                else if (rsi >= 65) {
                    signal = "PUT (SELL) 🔴";
                    boxClass = "result-box sell";
                    reason = isOTC ? `Mache a sou tèt (RSI overbought: ${rsi}). Rejte detekte.` : `RSI overbought (${rsi}) + Konfimasyon tandans anba.`;
                }
                else {
                    signal = "PA ANTRE (NO TRADE) ⚠️";
                    boxClass = "result-box neutral";
                    reason = `Kondisyon yo pa rantre nan nivo sekirite an. Tann yon lòt bouji.`;
                }

                res.className = boxClass;

                if (signal.includes("NO TRADE")) {
                    res.innerHTML = `
                        <div class="result-title">${selectedPair} (${selectedTime})</div>
                        <div>Estati: <b>${signal}</b></div>
                        <div class="details">📊 ${reason}</div>
                        <div class="details" style="color: #ffd54f; margin-top: 5px;">💡 Konsèy: Lè mache a gen avètisman sa a, chanje pè oswa tann kèk minit.</div>
                    `;
                } else {
                    res.innerHTML = `
                        <div class="result-title">${selectedPair} (${selectedTime})</div>
                        <div>Siyal: <b>${signal}</b></div>
                        <div class="details">📊 ${reason}</div>
                        <div class="details">🛡️ Sante Mache a: <b>Bon (Stab)</b></div>
                        <div id="countdown" class="timer-box">⏰ Tanbouji: Ap tann kòmansman nouvo bouji a...</div>
                    `;

                    let count = 5;
                    const timerElem = document.getElementById('countdown');
                    const interval = setInterval(() => {
                        if (count > 0) {
                            timerElem.innerHTML = `🔥 Bouji ap fèmen! Klike nan: <b>${count}s</b>`;
                            count--;
                        } else {
                            timerElem.innerHTML = `❌ Siyal ekspire! Tan bouji a fini.`;
                            clearInterval(interval);
                        }
                    }, 1000);
                }

            }, 1000);
        }
    </script>
</body>
</html>
